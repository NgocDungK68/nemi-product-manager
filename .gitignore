# =========================
# Java / Maven build
# =========================
/target/
**/target/
*.class
*.jar
*.war
*.ear

# =========================
# Spring Boot logs & temp
# =========================
*.log
/logs/
/tmp/

# =========================
# Maven settings (avoid committing secrets)
/settings.xml
.mvn/wrapper/maven-wrapper.jar

# =========================
# Sensitive configuration files
# =========================
# Common Spring Boot secrets
src/main/resources/application.yaml
src/main/resources/application.yml
src/main/resources/application.properties
src/main/resources/*.env
.env
*.env
*.local.env

# AWS / Cloud / Key configs
**/aws-credentials*
**/rds-credentials*
**/secrets.json
**/private-key.pem
**/public-key.pem

# =========================
# IDEs and editor configs
# =========================
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.vscode/
/.metadata/
/out/
/build/

# =========================
# OS-specific junk
# =========================
.DS_Store
Thumbs.db

# =========================
# Node/NPM leftovers (for future frontend bits)
# =========================
node_modules/

# =========================
# Docker artifacts
# =========================
/docker-compose-deploy.yml

# =========================
# Generated files
# =========================
**/*.generated.*

# =========================
# Others
# =========================
*.swp
*.swo
